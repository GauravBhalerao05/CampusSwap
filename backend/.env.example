# Server Configuration (Render automatically sets PORT in production)
PORT=5001
NODE_ENV=production

# Database Configuration (TiDB Cloud Serverless / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=campusswap
# DB_SSL: optional, defaults to true in production (required for TiDB Cloud)
DB_SSL=true

# Frontend & CORS Configuration (your deployed Vercel frontend URL)
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGIN=https://your-app.vercel.app

# JWT Configuration (generate a 32+ character random string in production)
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=24h
